FROM python:3.12-slim
WORKDIR /app
COPY requirements-frontend.txt .
RUN pip install --no-cache-dir -r requirements-frontend.txt
COPY frontend.py schema.json ./
RUN useradd -m appuser && chown -R appuser /app
USER appuser
EXPOSE 7860
CMD ["streamlit", "run", "frontend.py", "--server.address=0.0.0.0", "--server.port=7860", "--server.headless=true"]
